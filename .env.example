# PRIMARY REASONING MODEL (OpenAI-compatible endpoint)
# Examples of base URLs:
# OpenRouter: https://openrouter.ai/api/v1
# Groq:       https://api.groq.com/openai/v1
# DeepSeek:   https://api.deepseek.com/v1
# Ollama:     http://localhost:11434/v1
# LM Studio:  http://localhost:1234/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180
LLM_MAX_RETRIES=5
LLM_BATCH_SIZE=6

# OPTIONAL INDEPENDENT VERIFIER. Use a DIFFERENT model/provider from the primary model.
VERIFY_BASE_URL=
VERIFY_API_KEY=
VERIFY_MODEL=

# OPTIONAL VISION MODEL. Use a vision-capable model to inspect question-page diagrams,
# graphs, tables and experimental setups during final matching.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_IMAGES=8

# LOCAL SEMANTIC RETRIEVAL. Model downloads on first launch; no per-token API bill.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ENABLE_EMBEDDINGS=true

# PDF processing and matching controls.
OCR_ENABLED=true
RENDER_PAGE_IMAGES=true
EXPECTED_MOCK_QUESTIONS=180
EXPECTED_NEET_QUESTIONS=180
TOP_CANDIDATES=30
MAX_MATCHES_PER_NEET_QUESTION=12