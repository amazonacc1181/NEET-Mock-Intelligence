# Default local Ollama endpoint. setup_local_ai.py chooses and downloads the models
# that fit the computer, then writes the final .env automatically.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=600
LLM_MAX_RETRIES=4
LLM_BATCH_SIZE=3

# Filled automatically when the hardware supports an independent verifier model.
VERIFY_BASE_URL=http://127.0.0.1:11434/v1
VERIFY_API_KEY=ollama
VERIFY_MODEL=

# The primary Qwen model is multimodal and is also used for diagrams and graphs.
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_API_KEY=ollama
VISION_MODEL=qwen3.5:9b
VISION_MAX_IMAGES=3

# Local semantic retrieval. Model weights download automatically on first run.
EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_EMBEDDINGS=true
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=150

# PDF processing and matching controls.
OCR_ENABLED=true
RENDER_PAGE_IMAGES=true
EXPECTED_MOCK_QUESTIONS=180
EXPECTED_NEET_QUESTIONS=180
TOP_CANDIDATES=60
MAX_MATCHES_PER_NEET_QUESTION=15